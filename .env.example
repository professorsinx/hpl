# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# UPI account that receives the team entry fee
NEXT_PUBLIC_UPI_ID=yourname@bank
# Name shown in the payer's UPI app (optional, defaults to "HPL 2027")
NEXT_PUBLIC_UPI_PAYEE_NAME=Harshamitra Hospital

# Public address of the site, used for social previews and the sitemap
NEXT_PUBLIC_SITE_URL=https://your-domain.example
